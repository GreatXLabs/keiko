#VRML_SIM R2025a utf8

WorldInfo {
  info [
    "Bahia de Caza - Entorno de simulacion 3D para el Proyecto Orquitas (Keiko)",
    "Pista de 2.4m x 2.4m con muros de 20cm, salida de 30cm, plataforma de escape y presas."
  ]
  title "Bahia de Caza - Orquitas"
  basicTimeStep 32
  FPS 60
  contactProperties [
    ContactProperties {
      material1 "wheel"
      material2 "floor"
      coulombFriction [
        0.82
      ]
      forceDependentSlip [
        0.010
      ]
      bounce 0.0
    }
    ContactProperties {
      material1 "wheel"
      material2 "wall"
      coulombFriction [
        0.05
      ]
      forceDependentSlip [
        0.05
      ]
      bounce 0.0
    }
    ContactProperties {
      material1 "marble"
      material2 "floor"
      coulombFriction [
        0.12
      ]
      bounce 0.04
    }
    ContactProperties {
      material1 "marble"
      material2 "wheel"
      coulombFriction [
        0.45
      ]
      bounce 0.0
    }
    ContactProperties {
      material1 "marble"
      material2 "chassis"
      coulombFriction [
        0.25
      ]
      bounce 0.02
    }
    ContactProperties {
      material1 "marble"
      material2 "wall"
      coulombFriction [
        0.15
      ]
      bounce 0.2
    }
    ContactProperties {
      material1 "chassis"
      material2 "floor"
      coulombFriction [
        0.18
      ]
      forceDependentSlip [
        0.015
      ]
      bounce 0.01
    }
    ContactProperties {
      material1 "chassis"
      material2 "wall"
      coulombFriction [
        0.05
      ]
      bounce 0.01
    }
  ]
}

Viewpoint {
  orientation 0 1 0 0.70
  position -2.6 0 2.2
  follow "orquita_robot"
}

Background {
  skyColor [
    0.35 0.65 0.90
  ]
}

DirectionalLight {
  ambientIntensity 0.8
  direction 0.4 0.3 -1.0
  intensity 1.5
  castShadows TRUE
}

PointLight {
  ambientIntensity 0.5
  attenuation 0 0 1
  intensity 2.0
  location 0 0 2.2
}

# Suelo Principal de la Bahia de Caza (2.4m x 2.4m x 0.20m - Solido impenetrable)
DEF FLOOR Solid {
  translation 0 0 -0.10
  children [
    Shape {
      appearance DEF FLOOR_APP PBRAppearance {
        baseColor 0.15 0.25 0.35
        roughness 0.6
        metalness 0.1
      }
      geometry Box {
        size 2.4 2.4 0.20
      }
    }
  ]
  name "floor"
  contactMaterial "floor"
  boundingObject Box {
    size 2.4 2.4 0.20
  }
}

# Suelo de Seguridad Perimetral Extendido (10m x 10m a Z=-0.20) - Evita cualquier caida al vacio
DEF SAFETY_GROUND Solid {
  translation 0 0.5 -0.20
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.12 0.18
        roughness 0.8
        metalness 0.0
      }
      geometry Box {
        size 10.0 10.0 0.20
      }
    }
  ]
  name "safety_ground"
  contactMaterial "floor"
  boundingObject Box {
    size 10.0 10.0 0.20
  }
}

