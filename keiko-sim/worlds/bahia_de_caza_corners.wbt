  name "orquita_robot"
  contactMaterial "chassis"
  boundingObject Group {
    children [
      # Colisionador físico de las bandejas del chasis CAD (257mm x 150mm x 60mm, despejado del suelo)
      Pose {
        translation 0 0 0.048
        children [
          Box { size 0.257 0.150 0.055 }
        ]
      }
    ]
