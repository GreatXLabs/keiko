# ========================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO - PROYECTO ORQUITAS
# ========================================================

# Puerto TCP del Servidor Central (para simulador o puente RFCOMM)
PORT=5000

# Puerto Serie / Bluetooth SPP opcional (ej. COM5 en Windows, /dev/rfcomm0 o /dev/ttyACM0 en Linux)
# Dejar comentado si se conecta por TCP o se pasa por CLI (--serial COM5)
# SERIAL_PORT=COM5
SERIAL_BAUD=9600

# Archivo persistente del estómago ("La Linareada")
ESTOMAGO_FILE_NAME=estomago.txt
ESTOMAGO_FILE_PATH=estomago.txt

# Ruta al modelo neuronal primario Neuroph 2.98 (.nnet)
# ClasificadorNeuroph carga automáticamente modelo_ultrasonico.nnet + modelo_canicas.nnet
MODEL_FILE_PATH=models/modelo_ultrasonico.nnet

# Intervalo de sondeo del Hilo Auditor en milisegundos
AUDITOR_POLLING_MS=25

# Cantidad de capturas requeridas para activar el Modo Escape
CAPTURAS_REQUERIDAS_ESCAPE=3

# Ventana anti-rebote entre eventos de captura física (ms) y latido de enlace (< 500 ms)
CAPTURE_COOLDOWN_MS=1500
HEARTBEAT_INTERVAL_MS=200
