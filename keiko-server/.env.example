# ========================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO - PROYECTO ORQUITAS
# ========================================================

# Puerto de escucha del Servidor Central (TCP/RFCOMM)
PORT=5000

# Nombre y ruta del archivo del estómago persistente ("La Linareada")
# Una ruta relativa se resuelve contra el directorio de este archivo .env
ESTOMAGO_FILE_NAME=estomago.txt
ESTOMAGO_FILE_PATH=estomago.txt

# Ruta al modelo neuronal Neuroph 2.98 (.nnet)
MODEL_FILE_PATH=../keiko-sim/data/models/orquitas_production_champion.nnet

# Intervalo de sondeo del Hilo Auditor en milisegundos
AUDITOR_POLLING_MS=200

# Cantidad de capturas requeridas para activar el Modo Escape
CAPTURAS_REQUERIDAS_ESCAPE=3
